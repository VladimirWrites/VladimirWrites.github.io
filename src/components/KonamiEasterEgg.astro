---
// Hidden easter egg: the Konami code (up up down down left right left right B A)
// bursts the logo's triangles across the screen as confetti, then they fade.
---
<canvas id="konami-canvas" aria-hidden="true"></canvas>

<style>
  #konami-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    display: none;
  }
  #konami-canvas.active { display: block; }
</style>

<script>
  function initKonami() {
    const canvas = document.getElementById('konami-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Logo palette: J indigo->cyan shades, V greys, the amber dot.
    const BLUES = ['#6366f1', '#4f46e5', '#3b82f6', '#2563eb', '#22d3ee', '#38bdf8'];
    const GREYS = ['#cbd5e1', '#dbeafe'];
    const AMBER = '#f59e0b';

    type Piece = {
      x: number; y: number; vx: number; vy: number;
      size: number; rot: number; vr: number; up: boolean;
      color: string; life: number;
    };

    let pieces: Piece[] = [];
    let animationId = 0;
    let running = false;
    const SEQ = ['arrowup','arrowup','arrowdown','arrowdown','arrowleft','arrowright','arrowleft','arrowright','b','a'];
    let progress: string[] = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function pickColor() {
      const r = Math.random();
      if (r < 0.72) return BLUES[(Math.random() * BLUES.length) | 0];
      if (r < 0.92) return GREYS[(Math.random() * GREYS.length) | 0];
      return AMBER;
    }

    function spawn() {
      resize();
      const cx = canvas.width / 2;
      const cy = canvas.height * 0.42;
      const count = prefersReducedMotion ? 28 : 80;
      pieces = [];
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = prefersReducedMotion ? (1 + Math.random() * 2) : (4 + Math.random() * 11);
        pieces.push({
          x: cx + (Math.random() - 0.5) * 60,
          y: cy + (Math.random() - 0.5) * 40,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - (prefersReducedMotion ? 1 : 6),
          size: 7 + Math.random() * 11,
          rot: Math.random() * Math.PI * 2,
          vr: (Math.random() - 0.5) * (prefersReducedMotion ? 0.05 : 0.3),
          up: Math.random() < 0.5,
          color: pickColor(),
          life: 1,
        });
      }
      canvas.classList.add('active');
      if (!running) { running = true; loop(); }
    }

    function drawTriangle(p: Piece) {
      const h = p.size * 0.866;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.globalAlpha = Math.max(0, Math.min(1, p.life));
      ctx.fillStyle = p.color;
      ctx.beginPath();
      if (p.up) {
        ctx.moveTo(0, -h * 0.66);
        ctx.lineTo(-p.size / 2, h * 0.34);
        ctx.lineTo(p.size / 2, h * 0.34);
      } else {
        ctx.moveTo(0, h * 0.66);
        ctx.lineTo(-p.size / 2, -h * 0.34);
        ctx.lineTo(p.size / 2, -h * 0.34);
      }
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      let alive = 0;
      for (const p of pieces) {
        p.vy += prefersReducedMotion ? 0.08 : 0.35;   // gravity
        p.vx *= 0.99;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        // bounce once off the floor
        if (p.y > canvas.height - 4 && p.vy > 0) {
          p.y = canvas.height - 4;
          p.vy *= -0.45;
          p.vx *= 0.6;
        }
        p.life -= prefersReducedMotion ? 0.012 : 0.008;
        if (p.life > 0 && p.y < canvas.height + 40) { alive++; drawTriangle(p); }
      }
      if (alive > 0) {
        animationId = requestAnimationFrame(loop);
      } else {
        running = false;
        canvas.classList.remove('active');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    }

    function onKey(e: KeyboardEvent) {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      const k = e.key.toLowerCase();
      progress.push(k);
      if (progress.length > SEQ.length) progress.shift();
      if (progress.length === SEQ.length && SEQ.every((v, i) => v === progress[i])) {
        progress = [];
        spawn();
      }
    }

    window.addEventListener('keydown', onKey);
    window.addEventListener('resize', resize);

    function cleanup() {
      cancelAnimationFrame(animationId);
      running = false;
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('resize', resize);
      canvas.classList.remove('active');
      document.removeEventListener('astro:before-swap', cleanup);
    }
    document.addEventListener('astro:before-swap', cleanup);
  }

  initKonami();
  document.addEventListener('astro:after-swap', initKonami);
</script>
